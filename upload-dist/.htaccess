# SPA fallback for Apache (Plesk's default backend behind nginx).
#
# react-router owns every path that is not a real file on disk, so a direct
# hit or refresh on /challenges must return index.html rather than 404.
# /api/ never reaches Apache — nginx proxies it to Base44 first — but it is
# excluded here too so a misconfigured proxy fails loudly instead of quietly
# serving HTML where the SDK expects JSON.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
