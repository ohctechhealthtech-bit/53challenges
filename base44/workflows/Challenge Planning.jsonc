{
  "description": "When a brand submits a host-a-challenge proposal (PartnerInquiry created), Ty auto-plans the challenge by generating an AI challenge plan and saving it to the proposal.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "PartnerInquiry"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "challenge_planning",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "plan_challenge": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "planChallengeFromProposal",
            "args": {
              "inquiry_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Ty plans the challenge",
            "description": "Generate AI challenge plan from the proposal"
          }
        }
      }
    ]
  },
  "name": "Challenge Planning"
}