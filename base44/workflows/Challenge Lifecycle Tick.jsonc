{
  "name": "Challenge Lifecycle Tick",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "Australia/Brisbane",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "challenge_lifecycle_tick",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "advance_challenges": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "lifecycleTick"
          },
          "then": "end",
          "x-base44": {
            "title": "Advance due challenges",
            "description": "Opens entries, voting, and closes finished challenges"
          }
        }
      }
    ]
  },
  "description": "Every 15 minutes, advances native challenges through their lifecycle stages as their scheduled milestones are reached."
}