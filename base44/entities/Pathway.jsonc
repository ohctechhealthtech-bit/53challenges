{
  "name": "Pathway",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "national_state_ranking",
        "state_to_national",
        "local_to_state_to_national",
        "series_championship",
        "private_organisation",
        "invitational"
      ]
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "season_label": {
      "type": "string",
      "default": ""
    },
    "anchor_challenge_id": {
      "type": "string",
      "default": ""
    },
    "access_code": {
      "type": "string",
      "default": ""
    },
    "approved_organisations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "invited_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "points_scale": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [
        10,
        8,
        6,
        5,
        4,
        3,
        2,
        1
      ]
    },
    "promotion_count": {
      "type": "number",
      "default": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "name",
    "type"
  ]
}