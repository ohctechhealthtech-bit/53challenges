{
  "name": "ParticipantPost",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "default": ""
    },
    "entry_id": {
      "type": "string",
      "default": ""
    },
    "challenge_title": {
      "type": "string",
      "default": ""
    },
    "topic": {
      "type": "string",
      "default": ""
    },
    "tone": {
      "type": "string",
      "default": "friendly"
    },
    "content": {
      "type": "string",
      "default": ""
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "image_url": {
      "type": "string",
      "default": ""
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "shared"
      ],
      "default": "draft"
    },
    "shared_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}