{
  "name": "Promotion",
  "type": "object",
  "properties": {
    "pathway_id": {
      "type": "string"
    },
    "from_challenge_id": {
      "type": "string"
    },
    "to_challenge_id": {
      "type": "string"
    },
    "source_entry_id": {
      "type": "string"
    },
    "promoted_entry_id": {
      "type": "string",
      "default": ""
    },
    "creator_name": {
      "type": "string",
      "default": ""
    },
    "region": {
      "type": "string",
      "default": ""
    },
    "placing": {
      "type": "number",
      "default": 0
    },
    "promoted_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "promoted",
        "skipped"
      ],
      "default": "pending"
    }
  },
  "required": [
    "pathway_id",
    "from_challenge_id",
    "to_challenge_id",
    "source_entry_id"
  ]
}