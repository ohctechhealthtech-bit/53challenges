{
  "name": "ChallengeRecommendation",
  "type": "object",
  "properties": {
    "response_id": {
      "type": "string"
    },
    "host_organisation_id": {
      "type": "string",
      "description": "Reference to Organisation.id (repointed from HostOrganisation in Phase 0)."
    },
    "top_mechanics": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "top_categories": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "top_modes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "top_audiences": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "top_scoring": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "top_evidence": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "top_pathways": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "compliance_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "rationale_summary": {
      "type": "string",
      "default": ""
    },
    "service_tier_id": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "response_id",
    "host_organisation_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}