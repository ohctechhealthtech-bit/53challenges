{
  "name": "PartnerInquiry",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "default": "",
      "description": "Account email of the host who submitted this request. Ownership key for host view/edit."
    },
    "parent_request_id": {
      "type": "string",
      "default": "",
      "description": "Most recent request id returned by the main domain's request API."
    },
    "company_name": {
      "type": "string"
    },
    "company_website": {
      "type": "string",
      "default": ""
    },
    "industry": {
      "type": "string",
      "default": ""
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string",
      "default": ""
    },
    "challenge_title": {
      "type": "string",
      "default": ""
    },
    "challenge_type": {
      "type": "string",
      "default": ""
    },
    "challenge_goal": {
      "type": "string",
      "default": ""
    },
    "challenge_description": {
      "type": "string",
      "default": ""
    },
    "audience_description": {
      "type": "string",
      "default": ""
    },
    "audience_size": {
      "type": "string",
      "default": ""
    },
    "geographic_scope": {
      "type": "string",
      "default": ""
    },
    "launch_timing": {
      "type": "string",
      "default": ""
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Requested challenge start date."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Requested challenge end date."
    },
    "estimated_budget": {
      "type": "string",
      "default": ""
    },
    "prize_format": {
      "type": "string",
      "default": ""
    },
    "additional_notes": {
      "type": "string",
      "default": ""
    },
    "how_heard": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "planning",
        "contacted",
        "in-progress",
        "approved",
        "completed",
        "rejected"
      ],
      "default": "new"
    },
    "internal_notes": {
      "type": "string",
      "default": ""
    },
    "ai_plan": {
      "type": "object",
      "default": {}
    },
    "organisation_kind": {
      "type": "string",
      "enum": [
        "sponsor",
        "council",
        "school",
        "workplace",
        "other"
      ],
      "default": "other"
    },
    "pipeline_status": {
      "type": "string",
      "enum": [
        "new",
        "in_discussion",
        "confirmed",
        "live"
      ],
      "default": "new"
    },
    "sponsor_profile_id": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "company_name",
    "contact_name",
    "contact_email",
    "challenge_title",
    "challenge_description",
    "audience_description"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}