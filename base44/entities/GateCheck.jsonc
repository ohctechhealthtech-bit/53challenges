{
  "name": "GateCheck",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "gate_code": {
      "type": "string",
      "enum": [
        "draft_to_review",
        "review_to_approved",
        "approved_to_published",
        "entry_open",
        "voting_open"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "blocked"
      ],
      "default": "pending"
    },
    "passed_at": {
      "type": "string",
      "format": "date-time"
    },
    "passed_by_id": {
      "type": "string",
      "default": ""
    },
    "passed_by_email": {
      "type": "string",
      "default": ""
    },
    "grandfathered": {
      "type": "boolean",
      "default": false
    },
    "relocked_reason": {
      "type": "string",
      "default": ""
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "challenge_id",
    "gate_code"
  ]
}