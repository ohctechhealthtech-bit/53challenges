{
  "name": "CompetitionAssignment",
  "type": "object",
  "properties": {
    "competition_id": {
      "type": "string"
    },
    "competition_title": {
      "type": "string",
      "default": ""
    },
    "judge_profile_id": {
      "type": "string"
    },
    "judge_name": {
      "type": "string",
      "default": ""
    },
    "judge_email": {
      "type": "string",
      "default": ""
    },
    "role": {
      "type": "string",
      "enum": [
        "manager",
        "judge",
        "auditor"
      ]
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    }
  },
  "required": [
    "competition_id",
    "judge_profile_id",
    "role"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}