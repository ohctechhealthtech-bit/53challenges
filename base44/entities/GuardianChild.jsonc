{
  "name": "GuardianChild",
  "type": "object",
  "properties": {
    "guardian_id": {
      "type": "string"
    },
    "guardian_email": {
      "type": "string"
    },
    "child_name": {
      "type": "string"
    },
    "child_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "linked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "guardian_id",
    "guardian_email",
    "child_name",
    "child_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.guardian_email": "{{user.email}}"
        },
        {
          "data.child_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}