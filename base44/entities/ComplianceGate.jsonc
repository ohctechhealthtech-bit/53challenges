{
  "name": "ComplianceGate",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "challenge_title": {
      "type": "string",
      "default": ""
    },
    "legal_review_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "cleared",
        "blocked"
      ],
      "default": "not_started"
    },
    "promoter_confirmed": {
      "type": "boolean",
      "default": false
    },
    "terms_approved": {
      "type": "boolean",
      "default": false
    },
    "minor_participation_reviewed": {
      "type": "boolean",
      "default": false
    },
    "voting_reviewed": {
      "type": "boolean",
      "default": false
    },
    "permit_position_recorded": {
      "type": "boolean",
      "default": false
    },
    "prize_funding_confirmed": {
      "type": "boolean",
      "default": false
    },
    "launch_blocked": {
      "type": "boolean",
      "default": true
    },
    "legal_review_reference": {
      "type": "string",
      "default": ""
    },
    "gate_notes": {
      "type": "string",
      "default": ""
    },
    "grandfathered_live": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "challenge_id"
  ]
}