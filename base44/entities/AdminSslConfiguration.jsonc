{
  "name": "AdminSslConfiguration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for this default SSL certificate."
    },
    "certificate_file_reference": {
      "type": "string",
      "default": "",
      "description": "Private-storage file URI for the certificate PEM. Server-side only; never returned to clients."
    },
    "private_key_file_reference": {
      "type": "string",
      "default": "",
      "description": "Private-storage file URI for the private key. Server-side only; never returned to clients."
    },
    "certificate_status": {
      "type": "string",
      "enum": [
        "configured",
        "missing",
        "invalid",
        "expired"
      ],
      "default": "configured"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Optional certificate expiry date."
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Exactly one configuration may be active at a time."
    },
    "updated_by": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}