{
  "name": "Message",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string"
    },
    "sender": {
      "type": "string",
      "enum": [
        "user",
        "team"
      ],
      "default": "user",
      "description": "Who wrote this message \u2014 the participant or the 53 Challenges team."
    },
    "participant_email": {
      "type": "string",
      "default": "",
      "description": "Email of the participant this thread belongs to (set on both user messages and team replies)."
    },
    "participant_name": {
      "type": "string",
      "default": ""
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participant_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participant_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}