{
  "name": "PrizePayout",
  "type": "object",
  "properties": {
    "ledger_id": {
      "type": "string"
    },
    "competition_id": {
      "type": "string"
    },
    "entry_id": {
      "type": "string",
      "default": ""
    },
    "placing": {
      "type": "number",
      "default": 0
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "winner_name": {
      "type": "string",
      "default": ""
    },
    "is_minor": {
      "type": "boolean",
      "default": false
    },
    "payee_type": {
      "type": "string",
      "enum": [
        "entrant",
        "guardian"
      ],
      "default": "entrant"
    },
    "payee_name": {
      "type": "string",
      "default": ""
    },
    "guardian_name": {
      "type": "string",
      "default": ""
    },
    "identity_verified": {
      "type": "boolean",
      "default": false
    },
    "payment_details_verified": {
      "type": "boolean",
      "default": false
    },
    "payment_method": {
      "type": "string",
      "default": ""
    },
    "payment_ref": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "audited",
        "approved",
        "paid"
      ],
      "default": "pending"
    },
    "auditor_signoff_by": {
      "type": "string",
      "default": ""
    },
    "auditor_signoff_name": {
      "type": "string",
      "default": ""
    },
    "auditor_signoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_approval_by": {
      "type": "string",
      "default": ""
    },
    "admin_approval_name": {
      "type": "string",
      "default": ""
    },
    "admin_approval_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "ledger_id",
    "competition_id"
  ]
}