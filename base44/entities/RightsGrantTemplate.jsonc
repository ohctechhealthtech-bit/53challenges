{
  "name": "RightsGrantTemplate",
  "type": "object",
  "properties": {
    "scope_code": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "tier1_mandatory",
        "tier2_standard",
        "tier3_extended",
        "marketing_contact"
      ]
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "clause_reference": {
      "type": "string",
      "default": ""
    },
    "default_duration": {
      "type": "string",
      "default": "competition_period"
    },
    "default_territory": {
      "type": "string",
      "default": "worldwide"
    },
    "default_attribution": {
      "type": "boolean",
      "default": true
    },
    "default_sublicensable": {
      "type": "boolean",
      "default": false
    },
    "default_revocable": {
      "type": "boolean",
      "default": true
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "legal_signoff": {
      "type": "object",
      "default": {},
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "is_current": {
      "type": "boolean",
      "default": true
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "retirement_date": {
      "type": "string",
      "format": "date-time"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "scope_code",
    "tier",
    "display_name",
    "clause_reference"
  ]
}