{
  "name": "HostInvoice",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "default": ""
    },
    "organisation_id": {
      "type": "string",
      "default": ""
    },
    "draft_id": {
      "type": "string",
      "default": ""
    },
    "proposal_id": {
      "type": "string",
      "default": ""
    },
    "purpose": {
      "type": "string",
      "enum": [
        "application",
        "deposit",
        "balance"
      ],
      "default": "application"
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Amount in cents (AUD)."
    },
    "currency": {
      "type": "string",
      "default": "aud"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "void"
      ],
      "default": "pending"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "default": ""
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}