{
  "name": "ChallengeDraft",
  "type": "object",
  "properties": {
    "origin": {
      "type": "string",
      "enum": [
        "admin_created",
        "corporate_intake",
        "host_apply"
      ],
      "default": "admin_created"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "host_managed",
        "admin_managed"
      ],
      "default": "admin_managed",
      "description": "Who creates and manages the challenge content: the host, or the 53 team."
    },
    "host_organisation_id": {
      "type": "string",
      "default": ""
    },
    "recommendation_id": {
      "type": "string",
      "default": ""
    },
    "service_tier_id": {
      "type": "string",
      "default": ""
    },
    "scale_band": {
      "type": "string",
      "default": ""
    },
    "program_scope": {
      "type": "string",
      "enum": [
        "single",
        "series",
        "annual_program"
      ],
      "default": "single"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "intake_received",
        "in_review",
        "builder_started",
        "submitted_for_review",
        "changes_requested",
        "terms_pending",
        "approved",
        "approved_and_signed",
        "rejected",
        "live"
      ],
      "default": "intake_received"
    },
    "challenge_id": {
      "type": "string",
      "default": ""
    },
    "challenge_title": {
      "type": "string",
      "default": ""
    },
    "challenge_description": {
      "type": "string",
      "default": ""
    },
    "host_type": {
      "type": "string",
      "default": ""
    },
    "delivery_level": {
      "type": "string",
      "default": ""
    },
    "participant_range": {
      "type": "string",
      "default": ""
    },
    "category": {
      "type": "string",
      "default": ""
    },
    "winner_method": {
      "type": "string",
      "default": ""
    },
    "divisions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "answers": {
      "type": "object",
      "default": {}
    },
    "admin_feedback": {
      "type": "string",
      "default": ""
    },
    "decline_reason": {
      "type": "string",
      "default": ""
    },
    "recommended_snapshot": {
      "type": "object",
      "default": {}
    },
    "compliance_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_template": {
      "type": "boolean",
      "default": false
    },
    "template_name": {
      "type": "string",
      "default": ""
    },
    "template_family_id": {
      "type": "string",
      "default": ""
    },
    "template_version": {
      "type": "number",
      "default": 1
    },
    "template_status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "superseded",
        "archived"
      ],
      "default": "draft"
    },
    "previous_version_id": {
      "type": "string",
      "default": ""
    },
    "superseded_by_id": {
      "type": "string",
      "default": ""
    },
    "superseded_at": {
      "type": "string",
      "format": "date-time"
    },
    "superseded_by_user": {
      "type": "string",
      "default": ""
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_by": {
      "type": "string",
      "default": ""
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_by": {
      "type": "string",
      "default": ""
    },
    "archive_reason": {
      "type": "string",
      "default": ""
    },
    "primary_category_id": {
      "type": "string",
      "default": ""
    },
    "subcategory_id": {
      "type": "string",
      "default": ""
    },
    "service_tier": {
      "type": "string",
      "enum": [
        "standard",
        "professional",
        "enterprise",
        "custom"
      ],
      "default": "standard"
    },
    "template_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "concept_pack": {
      "type": "object",
      "default": {}
    },
    "rules_pack": {
      "type": "object",
      "default": {}
    },
    "brand_pack": {
      "type": "object",
      "default": {}
    },
    "participation_pack": {
      "type": "object",
      "default": {}
    },
    "operations_pack": {
      "type": "object",
      "default": {}
    },
    "legal_pack": {
      "type": "object",
      "default": {}
    },
    "lock_map": {
      "type": "object",
      "default": {}
    },
    "template_recommendation_config": {
      "type": "object",
      "default": {}
    },
    "template_audit_log": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "template_id": {
      "type": "string",
      "default": ""
    },
    "template_family_id_snapshot": {
      "type": "string",
      "default": ""
    },
    "template_version_number_snapshot": {
      "type": "number"
    },
    "template_version_snapshot": {
      "type": "object",
      "default": {}
    },
    "template_snapshot_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "host_brand_overrides": {
      "type": "object",
      "default": {}
    },
    "admin_brand_adjustments": {
      "type": "object",
      "default": {}
    },
    "approved_brand_pack": {
      "type": "object",
      "default": {}
    },
    "approved_by": {
      "type": "string",
      "default": ""
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_locked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "origin"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.is_template": {
                "$ne": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.is_template": {
                "$ne": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}