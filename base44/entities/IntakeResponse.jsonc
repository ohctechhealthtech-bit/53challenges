{
  "name": "IntakeResponse",
  "type": "object",
  "properties": {
    "host_organisation_id": {
      "type": "string",
      "description": "Reference to Organisation.id (repointed from HostOrganisation in Phase 0)."
    },
    "questionnaire_id": {
      "type": "string"
    },
    "questionnaire_version": {
      "type": "number",
      "default": 1
    },
    "selected_option_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "free_text_answers": {
      "type": "object",
      "default": {}
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "recommendation_id": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "host_organisation_id",
    "questionnaire_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}