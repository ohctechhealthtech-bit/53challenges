{
  "name": "IntakeQuestion",
  "type": "object",
  "properties": {
    "questionnaire_id": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "single_select",
        "multi_select",
        "scale",
        "free_text"
      ],
      "default": "single_select"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_required": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "questionnaire_id",
    "prompt",
    "type"
  ]
}