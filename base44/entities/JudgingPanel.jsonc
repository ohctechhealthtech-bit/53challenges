{
  "name": "JudgingPanel",
  "type": "object",
  "properties": {
    "competition_id": {
      "type": "string"
    },
    "competition_title": {
      "type": "string",
      "default": ""
    },
    "competition_category": {
      "type": "string",
      "default": ""
    },
    "head_judge_profile_id": {
      "type": "string",
      "default": ""
    },
    "head_judge_name": {
      "type": "string",
      "default": ""
    },
    "judge_profile_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "default": ""
          },
          "weight": {
            "type": "number",
            "default": 1
          }
        }
      },
      "default": []
    },
    "scale_max": {
      "type": "number",
      "default": 10
    },
    "tie_breaker_index": {
      "type": "number",
      "default": 0
    },
    "calibration_entry_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "judge_weight": {
      "type": "number",
      "default": 0.7
    },
    "public_weight": {
      "type": "number",
      "default": 0.3
    },
    "weighting_visible": {
      "type": "boolean",
      "default": true
    },
    "results_locked": {
      "type": "boolean",
      "default": false
    },
    "results_locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "calibration",
        "scoring",
        "locked",
        "complete"
      ],
      "default": "draft"
    }
  },
  "required": [
    "competition_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}