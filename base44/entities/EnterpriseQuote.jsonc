{
  "name": "EnterpriseQuote",
  "type": "object",
  "properties": {
    "draft_id": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "packaged_floor": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "accepted",
        "declined"
      ],
      "default": "draft"
    },
    "account_manager": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "draft_id"
  ]
}