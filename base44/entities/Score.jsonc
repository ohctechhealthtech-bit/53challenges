{
  "name": "Score",
  "type": "object",
  "properties": {
    "panel_id": {
      "type": "string"
    },
    "entry_id": {
      "type": "string"
    },
    "anonymous_id": {
      "type": "string",
      "default": ""
    },
    "judge_profile_id": {
      "type": "string"
    },
    "judge_name": {
      "type": "string",
      "default": ""
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "compliance_flagged": {
      "type": "boolean",
      "default": false
    },
    "compliance_reason": {
      "type": "string",
      "enum": [
        "",
        "off_brief",
        "plagiarism",
        "unsafe_content",
        "rights_or_music",
        "ineligible_entrant",
        "other"
      ],
      "default": ""
    },
    "compliance_note": {
      "type": "string",
      "default": ""
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "none",
        "open",
        "upheld",
        "dismissed"
      ],
      "default": "none"
    },
    "compliance_resolved_by": {
      "type": "string",
      "default": ""
    },
    "compliance_resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "locked",
        "amended"
      ],
      "default": "draft"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "amendment_reason": {
      "type": "string",
      "default": ""
    },
    "amended_by": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "panel_id",
    "entry_id",
    "judge_profile_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}