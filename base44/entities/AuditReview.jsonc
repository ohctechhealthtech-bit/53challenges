{
  "name": "AuditReview",
  "type": "object",
  "properties": {
    "competition_id": {
      "type": "string"
    },
    "competition_title": {
      "type": "string",
      "default": ""
    },
    "panel_id": {
      "type": "string",
      "default": ""
    },
    "auditor_user_id": {
      "type": "string",
      "default": ""
    },
    "auditor_name": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "pre_launch",
        "pending_audit",
        "in_audit",
        "signed_off",
        "routed"
      ],
      "default": "not_started"
    },
    "pre_launch": {
      "type": "object",
      "default": {},
      "properties": {
        "terms_match": {
          "type": "boolean",
          "default": false
        },
        "checked_by": {
          "type": "string",
          "default": ""
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "default": ""
        }
      }
    },
    "checklist": {
      "type": "object",
      "default": {},
      "properties": {
        "scores_recomputed": {
          "type": "boolean",
          "default": false
        },
        "blind_judging_confirmed": {
          "type": "boolean",
          "default": false
        },
        "conflict_exclusions_confirmed": {
          "type": "boolean",
          "default": false
        },
        "winning_evidence_verified": {
          "type": "boolean",
          "default": false
        },
        "eligibility_confirmed": {
          "type": "boolean",
          "default": false
        },
        "random_sample_done": {
          "type": "boolean",
          "default": false
        },
        "random_sample_size": {
          "type": "number",
          "default": 0
        },
        "vote_integrity_done": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "recomputed": {
      "type": "object",
      "default": {},
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "matches_stored": {
          "type": "boolean",
          "default": false
        },
        "recomputed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "vote_integrity": {
      "type": "object",
      "default": {},
      "properties": {
        "scanned": {
          "type": "number",
          "default": 0
        },
        "flagged": {
          "type": "number",
          "default": 0
        },
        "excluded": {
          "type": "number",
          "default": 0
        },
        "notes": {
          "type": "string",
          "default": ""
        }
      }
    },
    "random_sample_entry_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "random_sample_judge_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "sign_off_by": {
      "type": "string",
      "default": ""
    },
    "sign_off_name": {
      "type": "string",
      "default": ""
    },
    "sign_off_at": {
      "type": "string",
      "format": "date-time"
    },
    "sign_off_notes": {
      "type": "string",
      "default": ""
    },
    "routed_to": {
      "type": "string",
      "enum": [
        "",
        "head_judge",
        "platform_admin"
      ],
      "default": ""
    },
    "routing_reason": {
      "type": "string",
      "default": ""
    },
    "re_audit_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "competition_id"
  ]
}