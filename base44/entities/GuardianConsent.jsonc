{
  "name": "GuardianConsent",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "entry_id": {
      "type": "string",
      "default": ""
    },
    "participant_name": {
      "type": "string"
    },
    "participant_email": {
      "type": "string",
      "default": ""
    },
    "requirement_id": {
      "type": "string"
    },
    "requirement_version": {
      "type": "number",
      "default": 1
    },
    "guardian_name": {
      "type": "string"
    },
    "guardian_relationship": {
      "type": "string",
      "default": ""
    },
    "guardian_contact": {
      "type": "string"
    },
    "method_used": {
      "type": "string",
      "enum": [
        "guardian_email_verification",
        "guardian_account_countersign",
        "school_bulk_consent"
      ],
      "default": "guardian_email_verification"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "granted",
        "declined",
        "withdrawn"
      ],
      "default": "pending"
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time"
    },
    "scopes_entering_challenge": {
      "type": "boolean",
      "default": false
    },
    "scopes_terms_acceptance": {
      "type": "boolean",
      "default": false
    },
    "scopes_personal_info_processing": {
      "type": "boolean",
      "default": false
    },
    "scopes_public_display_name": {
      "type": "boolean",
      "default": false
    },
    "scopes_public_display_age_bracket": {
      "type": "boolean",
      "default": false
    },
    "scopes_publication_of_entry_media": {
      "type": "boolean",
      "default": false
    },
    "scopes_promotional_reuse": {
      "type": "boolean",
      "default": false
    },
    "scopes_direct_communication_with_minor": {
      "type": "boolean",
      "default": false
    },
    "scopes_public_voting_participation": {
      "type": "boolean",
      "default": false
    },
    "scopes_prize_acceptance_payment": {
      "type": "boolean",
      "default": false
    },
    "scopes_event_travel_attendance": {
      "type": "boolean",
      "default": false
    },
    "scopes_appears_in_entry": {
      "type": "boolean",
      "default": false
    },
    "consent_wording_hash": {
      "type": "string",
      "default": ""
    },
    "withdrawal_reason": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "challenge_id",
    "participant_name",
    "guardian_name",
    "requirement_id"
  ]
}