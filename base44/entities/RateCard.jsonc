{
  "name": "RateCard",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "default": 1
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "superseded_by_id": {
      "type": "string",
      "default": ""
    },
    "change_note": {
      "type": "string",
      "default": ""
    },
    "tier_base_fees": {
      "type": "object",
      "default": {},
      "description": "Map of service_tier_id -> base fee"
    },
    "participants_included": {
      "type": "object",
      "default": {},
      "description": "Map of service_tier_id -> included participant count"
    },
    "per_extra_100": {
      "type": "object",
      "default": {},
      "description": "Map of service_tier_id -> fee per extra 100 participants"
    },
    "weeks_included": {
      "type": "object",
      "default": {},
      "description": "Map of service_tier_id -> included weeks"
    },
    "per_extra_week": {
      "type": "object",
      "default": {},
      "description": "Map of service_tier_id -> fee per extra week"
    },
    "judging_fees": {
      "type": "object",
      "default": {},
      "description": "expert_panel, public_voting, hybrid, measured_results"
    },
    "permit_assistance_fee": {
      "type": "number",
      "default": 0
    },
    "prize_admin_pct": {
      "type": "number",
      "default": 0
    },
    "addon_fees": {
      "type": "object",
      "default": {},
      "description": "marketing_boost, video_moderation, branded_page"
    },
    "program_discounts": {
      "type": "object",
      "default": {},
      "description": "series_of_3 (pct), annual_of_6 (pct)"
    },
    "gst_pct": {
      "type": "number",
      "default": 10
    }
  },
  "required": [
    "version"
  ]
}