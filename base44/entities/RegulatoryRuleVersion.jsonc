{
  "name": "RegulatoryRuleVersion",
  "type": "object",
  "properties": {
    "rule_code": {
      "type": "string"
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "condition_expression": {
      "type": "object",
      "default": {}
    },
    "obligation_type": {
      "type": "string",
      "enum": [
        "permit_required",
        "notification_required",
        "legal_review_required",
        "consent_required",
        "tandc_clause_required",
        "prize_restriction",
        "recordkeeping",
        "advertising_restriction"
      ]
    },
    "detail": {
      "type": "string",
      "default": ""
    },
    "blocking": {
      "type": "boolean",
      "default": true
    },
    "satisfied_by": {
      "type": "string",
      "enum": [
        "permit_record",
        "legal_signoff",
        "consent_records",
        "tandc_clause",
        "evidence_item",
        "authority_reference"
      ],
      "default": "evidence_item"
    },
    "gate": {
      "type": "string",
      "enum": [
        "publish",
        "open_entry",
        "accept_minors",
        "open_voting",
        "close_and_judge",
        "publish_results",
        "release_prize"
      ],
      "default": "publish"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "legal_signoff": {
      "type": "object",
      "default": {},
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "is_current": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "rule_code",
    "version_number",
    "obligation_type"
  ]
}