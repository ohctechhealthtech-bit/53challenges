{
  "name": "ComplianceAuditEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "assessment_run",
        "finding_created",
        "finding_updated",
        "finding_waived",
        "evidence_linked",
        "rule_signed",
        "rule_version_created",
        "trigger_evaluated",
        "gate_passed",
        "gate_relocked",
        "gate_evaluated"
      ]
    },
    "challenge_id": {
      "type": "string",
      "default": ""
    },
    "assessment_id": {
      "type": "string",
      "default": ""
    },
    "finding_id": {
      "type": "string",
      "default": ""
    },
    "actor_id": {
      "type": "string",
      "default": ""
    },
    "actor_email": {
      "type": "string",
      "default": ""
    },
    "detail": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "event_type"
  ]
}