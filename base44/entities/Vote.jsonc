{
  "name": "Vote",
  "type": "object",
  "properties": {
    "entry_id": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string",
      "default": ""
    },
    "user_id": {
      "type": "string",
      "default": ""
    },
    "user_email": {
      "type": "string"
    },
    "voter_verified": {
      "type": "boolean",
      "default": true
    },
    "excluded": {
      "type": "boolean",
      "default": false
    },
    "excluded_reason": {
      "type": "string",
      "default": ""
    },
    "excluded_at": {
      "type": "string",
      "format": "date-time"
    },
    "excluded_by": {
      "type": "string",
      "default": ""
    },
    "flag_type": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "entry_id",
    "user_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}