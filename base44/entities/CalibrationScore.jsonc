{
  "name": "CalibrationScore",
  "type": "object",
  "properties": {
    "panel_id": {
      "type": "string"
    },
    "judge_profile_id": {
      "type": "string"
    },
    "judge_name": {
      "type": "string",
      "default": ""
    },
    "entry_id": {
      "type": "string"
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "comments": {
      "type": "string",
      "default": ""
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "panel_id",
    "judge_profile_id",
    "entry_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}