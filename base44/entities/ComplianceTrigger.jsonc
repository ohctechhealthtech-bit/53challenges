{
  "name": "ComplianceTrigger",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "detection_source": {
      "type": "string",
      "enum": [
        "scoring_model",
        "mechanic",
        "voting_configuration",
        "audience_type",
        "prize_config",
        "entry_config",
        "evidence_requirement",
        "participation_mode",
        "rights_configuration"
      ]
    },
    "detection_definition": {
      "type": "object",
      "default": {}
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "code",
    "name",
    "detection_source"
  ]
}