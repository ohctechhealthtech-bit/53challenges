{
  "name": "ChallengeRightsConfiguration",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "included_scope_versions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "music_policy": {
      "type": "string",
      "enum": [
        "original_or_licensed_only",
        "platform_supplied_tracks",
        "commercial_music_display_only"
      ],
      "default": "original_or_licensed_only"
    },
    "third_party_policy": {
      "type": "string",
      "enum": [
        "none_permitted",
        "release_required",
        "incidental_ok_for_display"
      ],
      "default": "none_permitted"
    },
    "sponsor_use_period": {
      "type": "string",
      "default": ""
    },
    "marketing_contact_senders": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "challenge_id"
  ]
}