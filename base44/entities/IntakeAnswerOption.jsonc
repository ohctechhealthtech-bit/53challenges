{
  "name": "IntakeAnswerOption",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "weight": {
      "type": "number",
      "default": 1
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "mechanic_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "category_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "mode_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "audience_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "scoring_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "pathway_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "service_tier_id": {
      "type": "string",
      "default": ""
    },
    "scale_band_id": {
      "type": "string",
      "default": ""
    },
    "program_scope": {
      "type": "string",
      "enum": [
        "single",
        "series",
        "annual_program"
      ],
      "default": "single"
    },
    "compliance_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "question_id",
    "label"
  ]
}