{
  "name": "LaunchCompetition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string",
      "default": ""
    },
    "category": {
      "type": "string",
      "default": ""
    },
    "subcategory": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "coming_soon"
      ],
      "default": "coming_soon"
    },
    "geography": {
      "type": "string",
      "enum": [
        "national",
        "state"
      ],
      "default": "national"
    },
    "mechanic": {
      "type": "string",
      "default": ""
    },
    "participation": {
      "type": "string",
      "default": ""
    },
    "evidence": {
      "type": "string",
      "default": ""
    },
    "scoring_model": {
      "type": "string",
      "default": ""
    },
    "audience": {
      "type": "string",
      "default": ""
    },
    "pathway": {
      "type": "string",
      "default": "national_state_ranking"
    },
    "module_extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "hold_for_audit": {
      "type": "boolean",
      "default": true
    },
    "brief": {
      "type": "string",
      "default": ""
    },
    "eoi_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}