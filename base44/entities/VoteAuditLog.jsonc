{
  "name": "VoteAuditLog",
  "type": "object",
  "properties": {
    "vote_id": {
      "type": "string",
      "default": ""
    },
    "challenge_id": {
      "type": "string",
      "default": ""
    },
    "entry_id": {
      "type": "string",
      "default": ""
    },
    "actor": {
      "type": "string",
      "default": ""
    },
    "action": {
      "type": "string",
      "enum": [
        "flag",
        "exclude",
        "restore",
        "spike_detected",
        "duplicate_detected",
        "manual_exclude",
        "manual_restore"
      ],
      "default": "flag"
    },
    "reason": {
      "type": "string",
      "default": ""
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "action"
  ]
}