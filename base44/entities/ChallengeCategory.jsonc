{
  "name": "ChallengeCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "default": ""
    },
    "category_id": {
      "type": "string",
      "default": "",
      "description": "Reference to Category.id \u2014 presentation layer only, never a second taxonomy (Phase 0)."
    },
    "icon": {
      "type": "string",
      "default": "\ud83c\udfa8"
    },
    "tagline": {
      "type": "string",
      "default": ""
    },
    "short_description": {
      "type": "string",
      "default": ""
    },
    "full_description": {
      "type": "string",
      "default": ""
    },
    "hero_image": {
      "type": "string",
      "default": ""
    },
    "hero_video": {
      "type": "string",
      "default": ""
    },
    "theme_colour": {
      "type": "string",
      "default": "#ff4d4d"
    },
    "secondary_colour": {
      "type": "string",
      "default": "#ff7878"
    },
    "work_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "default": "\u2022"
          }
        }
      },
      "default": []
    },
    "learning_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "default": ""
          },
          "icon": {
            "type": "string",
            "default": "\u2728"
          }
        }
      },
      "default": []
    },
    "audience_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "eligibility_guidance": {
      "type": "string",
      "default": ""
    },
    "challenge_formats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "default": "\ud83d\udcc1"
          },
          "description": {
            "type": "string",
            "default": ""
          }
        }
      },
      "default": []
    },
    "gallery_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "faq_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "default": ""
          }
        }
      },
      "default": []
    },
    "seo_title": {
      "type": "string",
      "default": ""
    },
    "seo_description": {
      "type": "string",
      "default": ""
    },
    "social_image": {
      "type": "string",
      "default": ""
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "unpublished",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "slug"
  ]
}