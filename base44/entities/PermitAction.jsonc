{
  "name": "PermitAction",
  "type": "object",
  "properties": {
    "instrument_id": {
      "type": "string",
      "default": ""
    },
    "challenge_id": {
      "type": "string",
      "default": ""
    },
    "action_type": {
      "type": "string",
      "enum": [
        "apply",
        "notify_regulator",
        "renew",
        "lodge_winner_records",
        "publish_results_record",
        "amend"
      ]
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "done",
        "overdue"
      ],
      "default": "pending"
    },
    "assigned_to": {
      "type": "string",
      "default": ""
    },
    "evidence": {
      "type": "string",
      "default": ""
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "action_type"
  ]
}