{
  "name": "EmailVerification",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Lowercased email address the code was sent to."
    },
    "purpose": {
      "type": "string",
      "description": "What the code unlocks, e.g. sponsor_application, judge_application, guardian_consent."
    },
    "code": {
      "type": "string",
      "default": ""
    },
    "token": {
      "type": "string",
      "default": "",
      "description": "Proof-of-verification token issued once the code is confirmed."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "consumed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "email",
    "purpose"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}