{
  "name": "ComplianceGateLog",
  "type": "object",
  "properties": {
    "gate_id": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string",
      "default": ""
    },
    "action": {
      "type": "string",
      "enum": [
        "gate_created",
        "field_change",
        "launch_unblocked",
        "launch_blocked",
        "enforcement_block",
        "grandfathered",
        "synced"
      ],
      "default": "field_change"
    },
    "field_name": {
      "type": "string",
      "default": ""
    },
    "old_value": {
      "type": "string",
      "default": ""
    },
    "new_value": {
      "type": "string",
      "default": ""
    },
    "changed_by_id": {
      "type": "string",
      "default": ""
    },
    "changed_by_email": {
      "type": "string",
      "default": ""
    },
    "note": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "gate_id"
  ]
}