{
  "name": "PromoterAppointment",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "promoter_type": {
      "type": "string",
      "enum": [
        "platform53",
        "host_organisation",
        "joint"
      ],
      "default": "platform53"
    },
    "promoter_entity_name": {
      "type": "string",
      "default": ""
    },
    "abn": {
      "type": "string",
      "default": ""
    },
    "contact": {
      "type": "string",
      "default": ""
    },
    "appointed_by": {
      "type": "string",
      "default": ""
    },
    "appointed_at": {
      "type": "string",
      "format": "date-time"
    },
    "basis_document": {
      "type": "string",
      "default": ""
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "challenge_id",
    "promoter_type",
    "promoter_entity_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}