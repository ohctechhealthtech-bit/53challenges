{
  "name": "MarketingUseLog",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "entry_id": {
      "type": "string",
      "default": ""
    },
    "participant_name": {
      "type": "string",
      "default": ""
    },
    "used_by": {
      "type": "string",
      "enum": [
        "platform",
        "host"
      ],
      "default": "platform"
    },
    "channel": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "url_or_file": {
      "type": "string",
      "default": ""
    },
    "scopes_relied_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "checked_by": {
      "type": "string",
      "default": ""
    },
    "used_at": {
      "type": "string",
      "format": "date-time"
    },
    "takedown_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "completed"
      ],
      "default": "not_required"
    },
    "takedown_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "challenge_id",
    "used_by"
  ]
}