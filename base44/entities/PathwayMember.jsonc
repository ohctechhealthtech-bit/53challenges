{
  "name": "PathwayMember",
  "type": "object",
  "properties": {
    "pathway_id": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string"
    },
    "challenge_title": {
      "type": "string",
      "default": ""
    },
    "member_kind": {
      "type": "string",
      "enum": [
        "anchor",
        "qualifier",
        "state_qualifier",
        "local_qualifier",
        "series_event"
      ],
      "default": "series_event"
    },
    "region": {
      "type": "string",
      "default": ""
    },
    "tier": {
      "type": "number",
      "default": 1
    },
    "promotion_to_challenge_id": {
      "type": "string",
      "default": ""
    },
    "promotion_count_override": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "pathway_id",
    "challenge_id",
    "member_kind"
  ]
}