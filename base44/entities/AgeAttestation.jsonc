{
  "name": "AgeAttestation",
  "properties": {
    "age_years": {
      "type": "number"
    },
    "date_of_birth": {
      "format": "date",
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "status": {
      "default": "confirmed",
      "enum": [
        "confirmed",
        "blocked_underage"
      ],
      "type": "string"
    },
    "user_id": {
      "default": "",
      "type": "string"
    }
  },
  "required": [
    "email",
    "date_of_birth",
    "age_years"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}