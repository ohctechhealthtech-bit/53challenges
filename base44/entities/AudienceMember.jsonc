{
  "name": "AudienceMember",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "default": ""
    },
    "audience_type": {
      "type": "string",
      "enum": [
        "creator",
        "voter",
        "sponsor",
        "parent",
        "educator",
        "other"
      ],
      "default": "creator"
    },
    "state": {
      "type": "string",
      "default": ""
    },
    "category_interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "participated_before": {
      "type": "boolean",
      "default": false
    },
    "entry_count": {
      "type": "number",
      "default": 0
    },
    "vote_count": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "coming_soon",
        "manual",
        "group_signup",
        "inquiry"
      ],
      "default": "coming_soon"
    },
    "organisation_id": {
      "type": "string",
      "default": ""
    },
    "organisation_name": {
      "type": "string",
      "default": ""
    },
    "is_registered_user": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "unsubscribed"
      ],
      "default": "active"
    },
    "unsubscribed_at": {
      "type": "string",
      "format": "date-time"
    },
    "welcomed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}