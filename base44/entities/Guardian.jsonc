{
  "name": "Guardian",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "relationship": {
      "type": "string",
      "default": ""
    },
    "mobile": {
      "type": "string",
      "default": ""
    },
    "address": {
      "type": "string",
      "default": ""
    },
    "user_id": {
      "type": "string",
      "default": "",
      "description": "Set when the guardian registers/signs in on this app."
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "True once the guardian has signed in and claimed this record."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}