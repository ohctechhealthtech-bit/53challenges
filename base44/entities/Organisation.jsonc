{
  "name": "Organisation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string",
      "default": ""
    },
    "kind": {
      "type": "string",
      "enum": [
        "platform",
        "business",
        "school",
        "community_group",
        "club",
        "workplace",
        "council",
        "venue",
        "sponsor",
        "government",
        "individual_host"
      ],
      "default": "club",
      "description": "Organisation type (Phase 0 merge of HostOrganisation)."
    },
    "signup_code": {
      "type": "string"
    },
    "abn": {
      "type": "string",
      "default": ""
    },
    "account_type_id": {
      "type": "string",
      "default": "",
      "description": "Reference to HostAccountType.id"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "paid",
        "overdue"
      ],
      "default": "none"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified"
      ],
      "default": "unverified"
    },
    "contact_email": {
      "type": "string",
      "default": ""
    },
    "state": {
      "type": "string",
      "default": ""
    },
    "internal_notes": {
      "type": "string",
      "default": ""
    },
    "member_count": {
      "type": "number",
      "default": 0
    },
    "entry_count": {
      "type": "number",
      "default": 0
    },
    "vote_count": {
      "type": "number",
      "default": 0
    },
    "leaderboard_enabled": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "kind",
    "signup_code"
  ]
}