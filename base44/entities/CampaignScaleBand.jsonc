{
  "name": "CampaignScaleBand",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "service_fee_multiplier": {
      "type": "number",
      "default": 1.0
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "packaged",
        "by_proposal"
      ],
      "default": "packaged"
    },
    "routing": {
      "type": "string",
      "enum": [
        "standard_review",
        "enterprise_pipeline"
      ],
      "default": "standard_review"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}