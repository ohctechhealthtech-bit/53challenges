{
  "name": "PermitOrAuthority",
  "type": "object",
  "properties": {
    "jurisdiction_code": {
      "type": "string",
      "enum": [
        "NSW",
        "VIC",
        "QLD",
        "WA",
        "SA",
        "TAS",
        "ACT",
        "NT",
        "NATIONAL"
      ]
    },
    "instrument_type": {
      "type": "string",
      "enum": [
        "authority_multiyear",
        "permit_single_promotion",
        "licence"
      ]
    },
    "holder": {
      "type": "string",
      "enum": [
        "platform53",
        "host_organisation"
      ]
    },
    "holder_entity_name": {
      "type": "string",
      "default": ""
    },
    "reference_number": {
      "type": "string"
    },
    "issued_date": {
      "type": "string",
      "format": "date"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "issued",
        "active",
        "expiring_soon",
        "expired",
        "refused",
        "surrendered"
      ],
      "default": "applied"
    },
    "covered_challenges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "fee": {
      "type": "number",
      "default": 0
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "jurisdiction_code",
    "instrument_type",
    "holder",
    "reference_number"
  ]
}