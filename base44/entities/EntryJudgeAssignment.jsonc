{
  "name": "EntryJudgeAssignment",
  "type": "object",
  "properties": {
    "panel_id": {
      "type": "string"
    },
    "entry_id": {
      "type": "string"
    },
    "anonymous_id": {
      "type": "string"
    },
    "judge_profile_id": {
      "type": "string"
    },
    "judge_name": {
      "type": "string",
      "default": ""
    },
    "blind_work_type": {
      "type": "string",
      "default": "text"
    },
    "blind_work_text": {
      "type": "string",
      "default": ""
    },
    "blind_work_link": {
      "type": "string",
      "default": ""
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "panel_id",
    "entry_id",
    "anonymous_id",
    "judge_profile_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}