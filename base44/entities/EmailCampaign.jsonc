{
  "name": "EmailCampaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "announcement",
        "deadline_reminder",
        "results",
        "voting_open",
        "results_announced"
      ],
      "default": "announcement"
    },
    "audience_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "participated_only": {
      "type": "boolean",
      "default": false
    },
    "competition_id": {
      "type": "string",
      "default": ""
    },
    "subject": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent"
      ],
      "default": "draft"
    },
    "audience_count": {
      "type": "number",
      "default": 0
    },
    "sent_count": {
      "type": "number",
      "default": 0
    },
    "skipped_unregistered": {
      "type": "number",
      "default": 0
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "name",
    "type"
  ]
}