{
  "name": "LifecycleGate",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "draft_to_review",
        "review_to_approved",
        "approved_to_published",
        "entry_open",
        "voting_open"
      ]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "name"
  ]
}