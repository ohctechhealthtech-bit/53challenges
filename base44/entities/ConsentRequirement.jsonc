{
  "name": "ConsentRequirement",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "guardian_email_verification",
        "guardian_account_countersign",
        "school_bulk_consent"
      ],
      "default": "guardian_email_verification"
    },
    "clause_reference": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "method"
  ]
}