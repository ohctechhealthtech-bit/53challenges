{
  "name": "SponsorProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "organisation": {
      "type": "string",
      "default": ""
    },
    "contact_name": {
      "type": "string",
      "default": ""
    },
    "contact_email": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "default": ""
    },
    "competition_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "contact_email"
  ]
}